# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Passo a passo completo: docs/guia-supabase.md
# O .env.local NUNCA vai para o Git (está no .gitignore).

# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
# Painel do Supabase → botão "Connect" no topo, ou Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (começa com sb_publishable_...). Pode ficar no navegador:
# quem protege os dados são as políticas RLS do banco.
# NÃO use aqui a secret key (sb_secret_...), que ignora o RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública da aplicação (usada em links compartilháveis e e-mails de autenticação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
