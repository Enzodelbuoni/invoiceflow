# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase Dashboard → Project Settings → API (ou "Connect" no topo do painel).

# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). A chave "anon" legada também funciona aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública da aplicação (usada em links compartilháveis e e-mails de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
